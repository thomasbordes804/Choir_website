# Copy to .env.local and fill in the values.
# Project ID and dataset are public (they appear in every asset URL).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only, read token. Create one at https://www.sanity.io/manage
# (API > Tokens). Never commit the real value.
SANITY_API_TOKEN=
